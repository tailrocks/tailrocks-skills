{
  "name": "tailrocks-skills-docs",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "bunx --bun fumadocs-mdx",
    "dev": "bunx --bun vite dev",
    "preview": "bunx --bun vite preview",
    "types:check": "bunx --bun fumadocs-mdx && bunx --bun tsc --noEmit",
    "finalize:site": "bun run scripts/finalize-static-site.ts",
    "check:site": "bun run scripts/check-static-site.ts",
    "build": "bunx --bun fumadocs-mdx && bunx --bun vite build && bun run finalize:site && bun run check:site"
  },
  "dependencies": {
    "@tanstack/react-router": "1.170.29",
    "@tanstack/react-start": "1.168.46",
    "@tanstack/start-static-server-functions": "1.167.29",
    "@vitejs/plugin-react": "6.0.5",
    "fumadocs-core": "16.14.4",
    "fumadocs-mdx": "15.2.3",
    "fumadocs-ui": "16.14.4",
    "mermaid": "11.16.1",
    "next-themes": "0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "vite": "8.2.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/bun": "1.3.14",
    "@types/mdx": "2.0.14",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2"
  }
}
